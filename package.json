{
  "name": "mixed_beverages",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build:css": "sass mixed_beverages/static_src/js/app.scss:mixed_beverages/static/app.css",
    "build:js": "bun build mixed_beverages/static_src/js/app.js --outfile mixed_beverages/static/app.bundle.js --format esm",
    "build": "bun run build:css && bun run build:js",
    "watch:css": "sass mixed_beverages/static_src/js/app.scss:mixed_beverages/static/app.css --embed-source-map --watch",
    "watch:js": "bun build mixed_beverages/static_src/js/app.js --outfile mixed_beverages/static/app.bundle.js --format esm --sourcemap=inline --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "django": "./manage.py runserver",
    "dev": "bun run --parallel 'watch:*' django"
  },
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/texas/tx_mixed_beverages.git"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "colorbrewer": "^1.7.0",
    "cookies-js": "^1.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "leaflet": "^1.9.4",
    "leaflet-hash": "^0.2.1",
    "leaflet.markercluster": "^1.5.3",
    "lodash": "^4.18.1",
    "prettier": "^3.9.10",
    "sass": "^1.107.1"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false
  },
  "dependencies": {
    "@condenast/quick-bus": "^0.2.0",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-color": "^3.1.0",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-time-format": "^4.1.0"
  }
}
