{
  "name": "mixed_beverages",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build:css": "sass mixed_beverages/static_src/js/app.scss:mixed_beverages/static/app.css",
    "build:js": "rollup -c",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "sass mixed_beverages/static_src/js/app.scss:mixed_beverages/static/app.css --embed-source-map --watch",
    "watch:js": "rollup -c -m inline --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "django": "./manage.py runserver",
    "dev": "concurrently --kill-others 'npm:watch:*' 'npm:django'"
  },
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/texas/tx_mixed_beverages.git"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "colorbrewer": "^1.6.2",
    "concurrently": "^9.2.1",
    "cookies-js": "^1.2.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "leaflet": "^1.9.4",
    "leaflet-hash": "^0.2.1",
    "leaflet.markercluster": "^1.5.3",
    "lodash": "^4.17.21",
    "prettier": "^3.4.2",
    "rollup": "^4.61.0",
    "sass": "^1.97.3"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false
  },
  "dependencies": {
    "@condenast/quick-bus": "^0.2.0",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-color": "^3.1.0",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-time-format": "^4.1.0"
  }
}
